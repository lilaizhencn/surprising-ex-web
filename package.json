{
  "name": "surprising-ex-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check src --error-on-warnings",
    "test": "vitest run",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "ky": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "react-doctor": "latest",
    "react-grab": "latest",
    "react-scan": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
